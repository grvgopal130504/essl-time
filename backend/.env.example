# ---------- server ----------
# Locally this is the port you type into the device. On Azure App Service,
# PORT is injected automatically — do NOT set it there.
PORT=8081
HOST=0.0.0.0

# ---------- database ----------
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DB_ENABLED=true

# Applied to the naive timestamps the device sends
TZ_OFFSET=+05:30

# Two scans by the same person inside this window count as one.
# Guards against double-taps flipping Check In into Check Out.
DEBOUNCE_SECONDS=120

# Splits the working day into halves. Check-in is drawn from the first half,
# check-out from the second. A day with punches in only one half = half day.
HALF_DAY_BOUNDARY=13:00

# Review thresholds. Days breaching these are FLAGGED for a human to check —
# never silently corrected.
MAX_DAY_HOURS=12      # longer than this is suspicious
MIN_DAY_HOURS=1       # shorter than this is suspicious
REVIEW_MIN_SCANS=3    # 3+ real scans means first/last may be guessing

# ---------- Azure / production only ----------
# App Service sets WEBSITE_HOSTNAME for you, so leave these blank there.
# Set PUBLIC_HOSTNAME only for a custom domain or a different reverse proxy.
# When either is present, /api/setup switches to "hosted" mode and tells the
# device to use the hostname + port 80 instead of a LAN IP + PORT.
PUBLIC_HOSTNAME=
# Override the port shown to the device (default: 80 when hosted, PORT on a LAN)
DEVICE_PORT=

# Read the real client IP from X-Forwarded-For (App Service, Front Door, nginx)
TRUST_PROXY=false

# Device guard. Empty = no restriction (fine on a LAN, NOT for a public endpoint).
# Comma-separated device serial numbers:
ALLOWED_SERIALS=
# Comma-separated public IPs. A trailing dot matches the whole /24, e.g. "203.0.113."
ALLOWED_DEVICE_IPS=

# Browser origins allowed to call /api and /ws. Empty = any (local dev only).
CORS_ORIGINS=

NODE_ENV=development
